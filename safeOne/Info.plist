<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Hear+h</string>

    <key>UIBackgroundModes</key>
    <array>
        <string>voip</string>
        <string>remote-notification</string>
        <string>audio</string>
    </array>

    <!-- ✅ TAMBAHKAN INI -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Hear+h membutuhkan mikrofon untuk video call darurat</string>

    <key>NSCameraUsageDescription</key>
    <string>Hear+h membutuhkan kamera untuk video call darurat</string>
    
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Hear+h membutuhkan akses galeri untuk foto reminder</string>

    <!-- NSAllowsArbitraryLoads intentionally omitted — production uses HTTPS (Vercel).
         For local HTTP testing, add it back temporarily in a Debug-only Info.plist. -->
</dict>
</plist>
